{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "",
	"buildCommand": "",
	"outputDirectory": "public",
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				},
				{
					"key": "Cache-Control",
					"value": "private, no-cache"
				}
			]
		}
	]
}
